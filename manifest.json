{
  "manifest_version": 3,
  "name": "Pinterest Human-Like Auto Pin",
  "version": "1.0",
  "description": "Automate Pinterest Pins from Excel with human-like behavior.",
  "permissions": ["storage", "alarms", "tabs", "scripting"],
  "host_permissions": ["https://*.pinterest.com/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.pinterest.com/pin-builder/"],
      "js": ["utils/humanBehavior.js", "content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["utils/humanBehavior.js"],
      "matches": ["https://www.pinterest.com/*"]
    }
  ]
}
